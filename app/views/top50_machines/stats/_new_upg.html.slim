.container-fluid
  .menu-container
    table.mb-3 style="border: none;"
      tr style="border: none; vertical-align: middle;"
        td style="border: none; padding-right: 8px; white-space: nowrap; font-weight: bold;" Метрика:
        td style="border: none; padding-right: 16px;"
          select#new-upg-bar-graph-selector.form-control style="width: 240px;"
            option value="total" selected="selected" Количество новых и обновлённых систем
            option value="rpeak_pct" Доля Rpeak новых и обновлённых систем
            option value="rmax_pct" Доля Rmax новых и обновлённых систем
        td style="border: none; padding-right: 8px; white-space: nowrap; font-weight: bold;" Редакции:
        td style="border: none; padding-right: 4px;"
          select#new-upg-edition-start.form-control style="width: 120px;"
            - dates_new_upg = (@edition_dates_new_upg || [])
            - dates_new_upg.each_with_index.to_a.reverse_each do |pair|
              - label, i = pair
              option value=(i + 1) selected=(i == (dates_new_upg.size - 1)) = label
        td style="border: none; padding-right: 16px;"
          select#new-upg-edition-end.form-control style="width: 120px;"
            - dates_new_upg = (@edition_dates_new_upg || [])
            - dates_new_upg.each_with_index.to_a.reverse_each do |pair|
              - label, i = pair
              option value=(i + 1) selected=(i == 0) = label
