div.new-upg-chart-wrapper#new-upg-bar-graph-rmax-pct style="max-width: 1000px;"
  div.new-upg-chart-header id="chart_new_vs_upgraded_rmax_pct_header" style="text-align: center; width: 100%; box-sizing: border-box; min-height: 80px;"
  div.new-upg-charts-scroll style="max-width: 1000px; width: 100%; overflow-x: auto; overflow-y: visible; display: flex; box-sizing: border-box;"
