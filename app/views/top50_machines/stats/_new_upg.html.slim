javascript:
  window.editionDatesNewUpg = #{raw (@edition_dates_new_upg || []).to_json};
  window.ratingsSummaryNewUpg = #{raw (@ratings_summary_for_js || []).to_json};
script
  | window.newUpgPayloadUrl = "#{request.path}.json";
  | window.newUpgDataByKey = { ratings_chart_data: #{raw (@ratings_chart_data || []).to_json} };
  | window.chartData = window.newUpgDataByKey.ratings_chart_data;
  | window.chartDataRpeakPct = [];
  | window.chartDataRmaxPct = [];

div.new-upg-chart-wrapper#new-upg-bar-graph-total style="max-width: 1000px;"
  div.new-upg-chart-header id="chart_new_vs_upgraded_header" style="text-align: center; width: 100%; box-sizing: border-box; min-height: 80px;"
  div.new-upg-charts-scroll style="max-width: 1000px; width: 100%; overflow-x: auto; overflow-y: visible; display: flex; box-sizing: border-box;"
    div id="chart_new_vs_upgraded"

div.new-upg-chart-wrapper#new-upg-bar-graph-rpeak-pct style="max-width: 1000px;"
  div.new-upg-chart-header id="chart_new_vs_upgraded_rpeak_pct_header" style="text-align: center; width: 100%; box-sizing: border-box; min-height: 80px;"
  div.new-upg-charts-scroll style="max-width: 1000px; width: 100%; overflow-x: auto; overflow-y: visible; display: flex; box-sizing: border-box;"
