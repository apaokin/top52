div style="clear: both;"
a class="button" style="background: #6699CC; float: right; margin-bottom: 15px;" target="_blank" download="New_upgraded_systems.csv" id="download_new_upg"
  = "Скачать CSV"
table class="table table-hover" style="width: 1400px; margin: 0 auto; table-layout: fixed;"
  thead
    tr
      th style="text-align: center;" Редакция
      th style="text-align: center;" Новые машины
      th style="text-align: center;" Обновлённые машины
      th style="text-align: center;" Новые и обновлённые машины
      th style="text-align: center;" % Новых машин
      th style="text-align: center;" % Обновлённых машин
      th style="text-align: center;" % Новых и обновлённых машин
      th style="text-align: center;" % Rpeak/Rmax новых машин
      th style="text-align: center;" % Rpeak/Rmax обновлённых машин
      th style="text-align: center;" % Rpeak/Rmax новых и обновлённых машин
  tbody
    - (@ratings_table_rows || []).each_with_index do |row, idx|
      tr data-edition-index=(idx + 1)
        td style="text-align: center;"
          - if row[:list_num].present? && row[:date_value].present?
            - list_year = row[:date_value].split(".")[2]
            - list_month = row[:date_value].split(".")[1]
            = link_to "#{row[:list_num]}#{8209.chr}я (#{row[:date_value]})", get_archive_path(list_year, list_month)
          - else
            = row[:edition_label]
        td style="text-align: right;" = row[:new_machines]
        td style="text-align: right;" = row[:upgraded_machines]
        td style="text-align: right;" = row[:total_machines]
        td style="text-align: right;" = row[:pct_new].nil? ? "—" : "#{row[:pct_new]}%"
        td style="text-align: right;" = row[:pct_upg].nil? ? "—" : "#{row[:pct_upg]}%"
        td style="text-align: right;" = row[:pct_new_upg].nil? ? "—" : "#{row[:pct_new_upg]}%"
        - rpeak_new_s = row[:pct_rpeak_new].nil? ? "—" : "#{row[:pct_rpeak_new]}%"
        - rmax_new_s = row[:pct_rmax_new].nil? ? "—" : "#{row[:pct_rmax_new]}%"
        - rpeak_upg_s = row[:pct_rpeak_upg].nil? ? "—" : "#{row[:pct_rpeak_upg]}%"
        - rmax_upg_s = row[:pct_rmax_upg].nil? ? "—" : "#{row[:pct_rmax_upg]}%"
        - rpeak_new_upg_s = row[:pct_rpeak_new_upg].nil? ? "—" : "#{row[:pct_rpeak_new_upg]}%"
        - rmax_new_upg_s = row[:pct_rmax_new_upg].nil? ? "—" : "#{row[:pct_rmax_new_upg]}%"
        td style="text-align: right;" = (row[:pct_rpeak_new].nil? && row[:pct_rmax_new].nil?) ? "—" : "#{rpeak_new_s} / #{rmax_new_s}"
        td style="text-align: right;" = (row[:pct_rpeak_upg].nil? && row[:pct_rmax_upg].nil?) ? "—" : "#{rpeak_upg_s} / #{rmax_upg_s}"
        td style="text-align: right;" = (row[:pct_rpeak_new_upg].nil? && row[:pct_rmax_new_upg].nil?) ? "—" : "#{rpeak_new_upg_s} / #{rmax_new_upg_s}"
javascript:
  var csvNewUpg = JSON.parse("#{(@csv_string_new_upg || []).to_json}".replace(/&quot;/g, '"')).join("\n");
coffee:
  d3.selectAll("a").filter(() -> d3.select(this).attr("id") == "download_new_upg").attr("href", "data:attachment/csv," + csvNewUpg)
