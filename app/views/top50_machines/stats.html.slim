            [0.2, 'rgb(0,255,0)'],
            [0.4, 'rgb(255,255,0)'],
            [0.6, 'rgb(255,165,0)'],
            [0.8, 'rgb(255,0,0)'],
            [1.0, 'rgb(139,0,0)']
          ],
          colorbar: {
            title: {
              text: 'Количество систем',
              side: 'right',
              font: { size: 20 }
            },
            tickfont: { size: 18 }
          },
          hovertemplate:
