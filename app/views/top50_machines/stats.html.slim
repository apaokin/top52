        var COLORS = [], name = "";
        for (var i = 0; i < data.length; i++) {
          COLORS.push(d3.interpolatePlasma(i * 1. / (data.length - 1)));
        }
      coffee:
        draw_type(data, "chart_1", "Количество гибридных систем (по числу типов узлов) в редакциях Top50", "Дата (MM.YY)", "Количество систем", COLORS)
      br

