            dtick: 1,
            type: 'category'
          },
          width: 1000,
          margin: { l: 50, b: 120, r: 0, t: 0 }
        };

        Plotly.newPlot('heatmap-rank-years-chart', data, layout, { displayModeBar: false });

        document.getElementById('heatmap-rank-years-chart').on('plotly_click', function(eventData) {
          var rank = eventData.points[0].x;
          var years = eventData.points[0].y;
          var key = rank + "-" + years;
          var series = seriesByCell[key];

          var container = document.getElementById('rank-years-details');
          if (!series || series.length === 0) {
            container.innerHTML = `<p>Нет систем с начальной позицией <b>${rank}</b> и сроком пребывания <b>${years}</b> лет.</p>`;
            return;
          }

          function pluralizeYears(n) {
            if (n % 10 === 1 && n % 100 !== 11) return 'год';
            if ([2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100)) return 'года';
            return 'лет';
          }

          var yearsWord = pluralizeYears(years);
          var html = `<h4>Системы с начальной позицией <b>${rank}</b> и сроком пребывания <b>${years}</b> ${yearsWord}:</h4>`;
          html += `<table class="table table-bordered table-sm">
            <thead>
              <tr>
                <th>Система</th>
                <th>Первая редакция</th>
                <th>Последняя редакция</th>
              </tr>
            </thead>
            <tbody>`;

          series.forEach(function(sys) {
            var name = sys.name || 'н/д';
            var url = sys.machine_id ? `/systems/${sys.machine_id}` : '#';
            html += `<tr>
              <td><a href="${url}" target="_blank">${name}</a></td>
              <td>${sys.start}</td>
              <td>${sys.end}</td>
            </tr>`;
          });

          html += "</tbody></table>";
          container.innerHTML = html;
        });

      });


