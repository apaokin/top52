        var vendorColorMap = {
          "NVIDIA": "#4daf4a",
          "Intel": "#377eb8",
          "AMD": "#e41a1c"
        };

        var surface = {
          z: newZ,
          x: newRanks,
          y: newEditions,
          type: 'surface',
          colorscale: [[0, 'lightgray'], [1, 'lightgray']],
          opacity: 0.5,
          showscale: false,
          hoverinfo: 'skip'
        };

        var data = [surface];
        var vendorPoints = {};

        for (let i = 0; i < newVendor.length; i++) {
          for (let j = 0; j < newVendor[i].length; j++) {
            let vendorId = newVendor[i][j];
            let vendorName = vendorMap[vendorId] || "Unknown";
            if (!(vendorName in vendorColorMap)) continue;

            if (!vendorPoints[vendorName]) {
              vendorPoints[vendorName] = { x: [], y: [], z: [], text: [], ids: [] };
            }

            vendorPoints[vendorName].x.push(newRanks[j]);
            vendorPoints[vendorName].y.push(newEditions[i]);
            vendorPoints[vendorName].z.push(newZ[i][j]);
            vendorPoints[vendorName].text.push(newMachines[i][j]);
            vendorPoints[vendorName].ids.push(newIds[i][j]);
          }
        }

        const isFirefox = navigator.userAgent.toLowerCase().includes('firefox');
        const pointSize = isFirefox ? 4 : 6;
        Object.entries(vendorPoints).forEach(([vendorName, coords]) => {
          let color = vendorColorMap[vendorName] || "#999999";
          data.push({
            x: coords.x,
            y: coords.y,
            z: coords.z,
            text: coords.text,
            customdata: coords.ids,
            type: 'scatter3d',
            mode: 'markers',
            marker: {
              color: color,
              size: pointSize,
              opacity: 0.95,
              symbol: 'circle',
              line: { width: 1, color: '#000000' }
            },
            name: vendorName,
            legendgroup: vendorName,
            showlegend: false,
            hovertemplate:
              "<b>Система</b>: %{text}<br>" +
              "<b>Rmax</b>: %{z:.2f} ТФлопс<br>" +
              "<b>Позиция</b>: %{x}<br>" +
              "<b>Редакция</b>: %{y}<extra></extra>"
          });
        });

        Object.keys(vendorPoints).forEach((vendorName) => {
          let color = vendorColorMap[vendorName] || "#999999";
          data.push({
            x: [null], y: [null], z: [null],
            type: 'scatter3d',
            mode: 'markers',
            marker: {
              color: color,
              size: 10,
              symbol: 'circle',
              opacity: 1,
              line: { width: 1, color: '#000000' }
            },
            name: vendorName,
            legendgroup: vendorName,
            showlegend: true
          });
        });

        var layout = {
          scene: {
            xaxis: {
              title: { text: 'Позиция', font: { size: 20 } },
              tickmode: 'linear',
              dtick: 5
            },
            yaxis: {
              title: { text: 'Дата редакции', font: { size: 18 }, standoff: 20 },
              tickmode: 'array',
              tickvals: newEditions.filter((_, i) => i % 4 === 0),
              ticktext: newEditions.filter((_, i) => i % 4 === 0).map(date => {
                const parts = date.split('.');
                return `${parts[1]}.${parts[2]}`;
              }),
              tickangle: -60,
              automargin: true
            },
            zaxis: {
              title: { text: 'Rmax (TФлопс)', font: { size: 20 } },
              type: 'log',
              autorange: true
            },
            camera: {
              eye: { x: 1.25, y: 1.25, z: 1.25 }
            }
          },
          margin: { l: 0, r: 0, b: 0, t: 0 },
          legend: {
            x: 1,
            y: 1,
            traceorder: "normal",
            font: { size: 14 },
            bgcolor: 'rgba(255,255,255,0.6)',
            bordercolor: '#444',
            borderwidth: 1
          }
        };

        Plotly.react('plotly-3d-acc', data, layout, { displayModeBar: false });
      }

      ["rank-start", "rank-end", "edition-start", "edition-end"].forEach(id => {
        document.getElementById(id).addEventListener("change", updatePlot);
      });

      updatePlot();

      var plot = document.getElementById('plotly-3d-acc');
      plot.on('plotly_click', function(eventData) {
        var point = eventData.points?.[0];
        var machineId = point?.customdata;
        if (machineId) {
          window.open("/systems/" + machineId, "_blank");
        }
      });
    });

    
