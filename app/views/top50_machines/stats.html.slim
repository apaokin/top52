  div#plotly-3d-vendor style="height: 700px; width: 900px; margin-bottom: 40px;"

  javascript:
    document.addEventListener("DOMContentLoaded", function () {
      var z = #{raw @z_data.to_json};
      var vendorSurface = #{raw @vendor_data.to_json};
      var machines = #{raw @machine_names.to_json};
      var machineIds = #{raw @machine_ids.to_json};
      var editions = #{raw @edition_labels.to_json};
      var vendorMap = #{raw @vendor_labels.to_json};
      var ranks = Array.from({ length: 50 }, (_, i) => i + 1);

      const editionStart = document.getElementById("edition-start");
      const editionEnd = document.getElementById("edition-end");
      const rankStart = document.getElementById("rank-start");
      const rankEnd = document.getElementById("rank-end");

      function reverseIndex(i, size) {
        return size - 1 - i;
      }

      function updateEditionEndOptions() {
        const startIdx = parseInt(editionStart.value);
        for (let i = 0; i < editionEnd.options.length; i++) {
          editionEnd.options[i].hidden = i < startIdx;
        }
        if (parseInt(editionEnd.value) < startIdx) {
          editionEnd.value = startIdx;
        }
      }

      function updateEditionStartOptions() {
        const endIdx = parseInt(editionEnd.value);
        for (let i = 0; i < editionStart.options.length; i++) {
          editionStart.options[i].hidden = i > endIdx;
        }
        if (parseInt(editionStart.value) > endIdx) {
          editionStart.value = endIdx;
        }
      }

      function updateRankEndOptions() {
        const startIdx = parseInt(rankStart.value);
        for (let i = 0; i < rankEnd.options.length; i++) {
          rankEnd.options[i].hidden = i < startIdx;
        }
        if (parseInt(rankEnd.value) < startIdx) {
          rankEnd.value = startIdx;
        }
      }

      function updateRankStartOptions() {
        const endIdx = parseInt(rankEnd.value);
        for (let i = 0; i < rankStart.options.length; i++) {
          rankStart.options[i].hidden = i > endIdx;
        }
        if (parseInt(rankStart.value) > endIdx) {
          rankStart.value = endIdx;
        }
      }

      function updatePlot() {
        updateEditionEndOptions();
        updateEditionStartOptions();
        updateRankEndOptions();
        updateRankStartOptions();

        const es_menu = parseInt(editionStart.value);
        const ee_menu = parseInt(editionEnd.value);
        const rs = parseInt(rankStart.value);
        const re = parseInt(rankEnd.value);

        const size = editions.length;
        const es = reverseIndex(es_menu, size);
        const ee = reverseIndex(ee_menu, size);
        const start = Math.min(es, ee);
        const end = Math.max(es, ee);

        const newZ = z.slice(start, end + 1).map(row => row.slice(rs, re + 1));
        const newVendor = vendorSurface.slice(start, end + 1).map(row => row.slice(rs, re + 1));
        const newMachines = machines.slice(start, end + 1).map(row => row.slice(rs, re + 1));
        const newIds = machineIds.slice(start, end + 1).map(row => row.slice(rs, re + 1));
        const newEditions = editions.slice(start, end + 1);
        const newRanks = ranks.slice(rs, re + 1);

        const surface = {
          z: newZ,
          x: newRanks,
          y: newEditions,
          type: 'surface',
          colorscale: [[0, 'lightgray'], [1, 'lightgray']],
          opacity: 0.5,
          showscale: false,
          hoverinfo: 'skip'
        };

        const data = [surface];
        const vendorColorMap = {
          "AMD": "#e41a1c", "Intel": "#377eb8", "Hybrid": "#4daf4a",
          "Unknown": "#984ea3", "IBM": "#ff7f00", "HP": "#a65628"
        };

        const vendorPoints = {};
        for (let i = 0; i < newVendor.length; i++) {
          for (let j = 0; j < newVendor[i].length; j++) {
            const vendorId = newVendor[i][j];
            const vendorName = vendorMap[vendorId] || "Unknown";
            if (!vendorPoints[vendorName]) {
              vendorPoints[vendorName] = { x: [], y: [], z: [], text: [], ids: [] };
            }
            vendorPoints[vendorName].x.push(newRanks[j]);
            vendorPoints[vendorName].y.push(newEditions[i]);
            vendorPoints[vendorName].z.push(newZ[i][j]);
            vendorPoints[vendorName].text.push(newMachines[i][j]);
            vendorPoints[vendorName].ids.push(newIds[i][j]);
          }
        }

        const isFirefox = navigator.userAgent.toLowerCase().includes('firefox');
        const pointSize = isFirefox ? 4 : 6;

        Object.entries(vendorPoints).forEach(([vendorName, coords]) => {
          const color = vendorColorMap[vendorName] || "#999999";
          data.push({
            x: coords.x,
            y: coords.y,
            z: coords.z,
            text: coords.text,
            customdata: coords.ids,
            type: 'scatter3d',
            mode: 'markers',
            marker: {
              color: color, size: pointSize, opacity: 0.95,
              symbol: 'circle', line: { width: 1, color: '#000000' }
            },
            name: vendorName, legendgroup: vendorName, showlegend: false,
            hovertemplate:
              "<b>Система</b>: %{text}<br>" +
              "<b>Rmax</b>: %{z:.2f} ТФлопс<br>" +
              "<b>Позиция</b>: %{x}<br>" +
              "<b>Редакция</b>: %{y}<extra></extra>"
          });
        });

        Object.keys(vendorPoints).forEach((vendorName) => {
          const color = vendorColorMap[vendorName] || "#999999";
          data.push({
            x: [null], y: [null], z: [null],
            type: 'scatter3d', mode: 'markers',
            marker: {
              color: color, size: 10, symbol: 'circle',
              opacity: 1, line: { width: 1, color: '#000000' }
            },
            name: vendorName, legendgroup: vendorName, showlegend: true
          });
        });

        Plotly.react('plotly-3d-vendor', data, {
          scene: {
            xaxis: {
              title: { text: 'Позиция', font: { size: 20 } },
              tickmode: 'linear', dtick: 10
            },
            yaxis: {
              title: { text: 'Дата редакции', font: { size: 18 } },
              tickmode: 'array',
              tickvals: newEditions.filter((_, i) => i % 4 === 0),
              ticktext: newEditions.filter((_, i) => i % 4 === 0).map(date => {
                const parts = date.split('.');
                return `${parts[1]}.${parts[2]}`;
              }),
              tickangle: -60, automargin: true
            },
            zaxis: {
              title: { text: 'Rmax (ТФлопс)', font: { size: 20 } },
              type: 'log', autorange: true
            },
            camera: { eye: { x: 1.25, y: 1.25, z: 1.25 } }
          },
          margin: { l: 0, r: 0, b: 0, t: 0 },
          legend: {
            x: 1, y: 1, traceorder: "normal",
            font: { size: 14 },
            bgcolor: 'rgba(255,255,255,0.6)',
            bordercolor: '#444', borderwidth: 1
          }
        }, { displayModeBar: false });
      }

      ["rank-start", "rank-end", "edition-start", "edition-end"].forEach(id => {
        document.getElementById(id).addEventListener("change", updatePlot);
      });

      updatePlot();

      document.getElementById('plotly-3d-vendor')
        .on('plotly_click', function(eventData) {
          const machineId = eventData?.points?.[0]?.customdata;
          if (machineId) {
            window.open("/systems/" + machineId, "_blank");
          }
        });
    });


