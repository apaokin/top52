        }];

        var layout = {
          
          xaxis: {
            title: { text: 'Начальная позиция', font: { size: 18 } },
            tickangle: -45,
            tickfont: { size: 14 },
            tickmode: 'linear',
            dtick: 1,
            type: 'category'
          },
          yaxis: {
            title: { text: 'Лет в рейтинге', font: { size: 18 } },
