    var transitionMatrixData = #{raw @top50_top500_transition_matrix.to_json};
    var transitionMatrixContainer = document.getElementById('top50-top500-transition-matrix');
    var transitionCubeContainer = document.getElementById('top50-top500-transition-cube');

    if (transitionMatrixData) {
      var categories = transitionMatrixData.categories || [];
      var probabilityMatrix = transitionMatrixData.probability_matrix || [];
      var countMatrix = transitionMatrixData.count_matrix || [];
      var transitionDetails = transitionMatrixData.transition_details || {};
      var years = transitionMatrixData.years || [];
      var yearlyCubes = transitionMatrixData.yearly_probability_cubes || {};
      var showProbabilities = true;

      function formatTransitionDetails(fromCat, toCat) {
        var details = transitionDetails[fromCat] && transitionDetails[fromCat][toCat] ? transitionDetails[fromCat][toCat] : [];
        if (details.length === 0) return '<p>Нет данных о переходах</p>';
        
        var html = '<div style="max-height: 400px; overflow-y: auto;">';
        html += '<table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 10px;">';
        html += '<thead><tr style="background-color: #f5f5f5; border-bottom: 2px solid #ddd;">';
        html += '<th style="padding: 8px; text-align: left; border: 1px solid #ddd;">Система</th>';
        html += '<th style="padding: 8px; text-align: center; border: 1px solid #ddd;">От позиции</th>';
        html += '<th style="padding: 8px; text-align: center; border: 1px solid #ddd;">К позиции</th>';
        html += '<th style="padding: 8px; text-align: left; border: 1px solid #ddd;">Период</th>';
        html += '</tr></thead><tbody>';
        
        details.forEach(function(detail, index) {
          var rowStyle = index % 2 === 0 ? 'background-color: #f9f9f9;' : 'background-color: white;';
          html += '<tr style="' + rowStyle + '">';
          html += '<td style="padding: 6px; border: 1px solid #ddd;">' + (detail.system || 'н/д') + '</td>';
          html += '<td style="padding: 6px; text-align: center; border: 1px solid #ddd;">' + detail.from_position + '</td>';
          html += '<td style="padding: 6px; text-align: center; border: 1px solid #ddd;">' + detail.to_position + '</td>';
          html += '<td style="padding: 6px; border: 1px solid #ddd;">' + detail.from_slot + ' → ' + detail.to_slot + '</td>';
          html += '</tr>';
        });
        
        html += '</tbody></table></div>';
        return html;
      }

      function updateTransitionMatrix() {
        var matrix = showProbabilities ? probabilityMatrix : countMatrix;
        var title = showProbabilities ? 'Вероятности переходов (%)' : 'Количество переходов';
        var colorscale = showProbabilities 
          ? [[0, '#ffffff'], [0.1, '#e3f2fd'], [0.3, '#90caf9'], [0.5, '#42a5f5'], [0.7, '#1e88e5'], [1, '#1565c0']]
          : [[0, '#ffffff'], [0.1, '#fff3e0'], [0.3, '#ffb74d'], [0.5, '#ff9800'], [0.7, '#f57c00'], [1, '#e65100']];

        // Создаем массив для hover-текста с деталями
        var hoverTexts = [];
        for (var i = 0; i < categories.length; i++) {
          var row = [];
          for (var j = 0; j < categories.length; j++) {
            var fromCat = categories[i];
            var toCat = categories[j];
            var value = matrix[i][j];
            var details = transitionDetails[fromCat] && transitionDetails[fromCat][toCat] ? transitionDetails[fromCat][toCat] : [];
            
            var hoverText = '<b>От:</b> ' + fromCat + '<br><b>К:</b> ' + toCat + '<br>';
            if (showProbabilities) {
              hoverText += '<b>Вероятность:</b> ' + value.toFixed(1) + '%<br>';
            } else {
              hoverText += '<b>Количество:</b> ' + value + '<br>';
            }
            
            if (details.length > 0) {
              var uniqueSystems = [];
              details.forEach(function(d) {
                if (uniqueSystems.indexOf(d.system) === -1) {
                  uniqueSystems.push(d.system);
                }
              });
              
              hoverText += '<b>Переходов:</b> ' + details.length + '<br>';
              hoverText += '<b>Систем:</b> ' + uniqueSystems.length + '<br>';
              
              if (uniqueSystems.length <= 5) {
                hoverText += '<b>Системы:</b> ' + uniqueSystems.join(', ') + '<br>';
              } else {
                hoverText += '<b>Системы:</b> ' + uniqueSystems.slice(0, 3).join(', ') + ' и еще ' + (uniqueSystems.length - 3) + '<br>';
              }
              
              hoverText += '<small style="color: #666;">Кликните для полного списка</small>';
            } else {
              hoverText += '<small style="color: #999;">Нет переходов</small>';
            }
            
            row.push(hoverText);
          }
          hoverTexts.push(row);
        }

        var hoverTemplate = '%{customdata}<extra></extra>';

        var heatmapTrace = {
          z: matrix,
          x: categories,
          y: categories,
          type: 'heatmap',
          colorscale: colorscale,
          showscale: true,
          colorbar: {
            title: showProbabilities ? 'Вероятность, %' : 'Количество',
            titleside: 'right',
            titlefont: { size: 12 }
          },
          text: matrix.map(function(row) {
            return row.map(function(val) {
              return showProbabilities ? val.toFixed(1) + '%' : val.toString();
            });
          }),
          texttemplate: '%{text}',
          textfont: { size: 10, color: '#000' },
          customdata: hoverTexts,
          hoverinfo: 'text',
          hovertemplate: hoverTemplate
        };

        var layout = {
          title: {
            text: title + ' между категориями позиций Top500',
            font: { size: 18, color: '#333' },
            x: 0.5,
            xanchor: 'center'
          },
          xaxis: {
            title: {
              text: 'Категория назначения',
              font: { size: 14 }
            },
            side: 'bottom',
            tickangle: -45
          },
          yaxis: {
            title: {
              text: 'Категория источника',
              font: { size: 14 }
            },
            autorange: 'reversed'
          },
          height: 700,
          margin: { l: 120, r: 50, t: 100, b: 150 },
          annotations: []
        };

        // Добавляем аннотации с числами на ячейки
        for (var i = 0; i < categories.length; i++) {
          for (var j = 0; j < categories.length; j++) {
            var value = matrix[i][j];
            if (value > 0) {
              var text = showProbabilities ? value.toFixed(1) + '%' : value.toString();
              layout.annotations.push({
                x: categories[j],
                y: categories[i],
                text: text,
                showarrow: false,
                font: { 
                  color: value > (showProbabilities ? 30 : 5) ? '#fff' : '#000',
                  size: 10
                }
              });
            }
          }
        }

        if (transitionMatrixContainer) {
          Plotly.react(transitionMatrixContainer, [heatmapTrace], layout, { 
            displayModeBar: true,
            modeBarButtonsToRemove: ['pan2d', 'lasso2d', 'select2d'],
            responsive: true
          });
        }

        // Обработчик клика на ячейку
        if (transitionMatrixContainer) {
          transitionMatrixContainer.on('plotly_click', function(eventData) {
            if (eventData && eventData.points && eventData.points.length > 0) {
              var point = eventData.points[0];
              var fromCat = point.y;
              var toCat = point.x;
              var details = transitionDetails[fromCat] && transitionDetails[fromCat][toCat] ? transitionDetails[fromCat][toCat] : [];
              
              if (details.length > 0) {
                var modalTitle = 'Переходы из категории ' + fromCat + ' в категорию ' + toCat;
                var modalContent = '<p><strong>Всего переходов:</strong> ' + details.length + '</p>';
                modalContent += formatTransitionDetails(fromCat, toCat);
                
                document.querySelector('#transition-details .modal-title').textContent = modalTitle;
                document.getElementById('transition-details-content').innerHTML = modalContent;
                
                // Показываем модальное окно
                var modal = document.getElementById('transition-details');
                if (typeof $ !== 'undefined' && $.fn.modal) {
                  $('#transition-details').modal('show');
                } else {
                  modal.style.display = 'block';
                  modal.style.zIndex = '1050';
                  document.body.style.overflow = 'hidden';
                  
                  // Добавляем затемнение фона
                  var backdrop = document.createElement('div');
                  backdrop.id = 'transition-details-backdrop';
                  backdrop.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1040;';
                  backdrop.onclick = function() {
                    modal.style.display = 'none';
                    document.body.style.overflow = '';
                    backdrop.remove();
                  };
                  document.body.appendChild(backdrop);
                }
              }
            }
          });
        }
      }

      // Обработчики переключения между вероятностями и количеством
      var showProbabilitiesRadio = document.getElementById('show-probabilities');
      var showCountsRadio = document.getElementById('show-counts');
      if (showProbabilitiesRadio && showCountsRadio && transitionMatrixContainer) {
        showProbabilitiesRadio.addEventListener('change', function() {
          if (this.checked) {
            showProbabilities = true;
            updateTransitionMatrix();
          }
        });

        showCountsRadio.addEventListener('change', function() {
          if (this.checked) {
            showProbabilities = false;
            updateTransitionMatrix();
          }
        });
      }

      // Инициализация heatmap
      if (transitionMatrixContainer) {
        updateTransitionMatrix();
      }

      // Расширенная версия матрицы переходов с фильтрацией по периодам
      var transitionMatrixDataExtended = #{raw @top50_top500_transition_matrix.to_json};
      if (transitionMatrixDataExtended && transitionMatrixDataExtended.all_transitions) {
        var allTransitions = transitionMatrixDataExtended.all_transitions || [];
        var categoriesExtended = transitionMatrixDataExtended.categories || [];
        var minYear = transitionMatrixDataExtended.min_year || new Date().getFullYear() - 5;
        var maxYear = transitionMatrixDataExtended.max_year || new Date().getFullYear();

        // Функция для построения матрицы переходов за указанный период
        function buildMatrixForPeriod(startYear, endYear, containerId, showProbabilitiesId, showCountsId) {
          var container = document.getElementById(containerId);
          if (!container) return;

          // Фильтруем переходы по периоду
          var filteredTransitions = allTransitions.filter(function(t) {
            return t.year >= startYear && t.year <= endYear;
          });

          if (filteredTransitions.length === 0) {
            container.innerHTML = '<p class="text-muted">Нет данных за выбранный период</p>';
            return;
          }

          // Строим матрицу переходов
          var transitionCounts = {};
          var transitionDetails = {};

          categoriesExtended.forEach(function(fromCat) {
            transitionCounts[fromCat] = {};
            transitionDetails[fromCat] = {};
            categoriesExtended.forEach(function(toCat) {
              transitionCounts[fromCat][toCat] = 0;
              transitionDetails[fromCat][toCat] = [];
            });
          });

          filteredTransitions.forEach(function(t) {
            if (t.from && t.to) {
              transitionCounts[t.from][t.to] += 1;
              transitionDetails[t.from][t.to].push({
                system: t.system || 'н/д',
                from_position: t.from_position,
                to_position: t.to_position,
                from_slot: t.from_slot,
                to_slot: t.to_slot
              });
            }
          });

          // Вычисляем вероятности
          var probabilityMatrix = [];
          var countMatrix = [];

          categoriesExtended.forEach(function(fromCat) {
            var probRow = [];
            var countRow = [];
            var totalFrom = Object.values(transitionCounts[fromCat]).reduce(function(a, b) { return a + b; }, 0);

            categoriesExtended.forEach(function(toCat) {
              var count = transitionCounts[fromCat][toCat];
              countRow.push(count);
              var probability = totalFrom > 0 ? (count / totalFrom * 100).toFixed(2) : 0;
              probRow.push(parseFloat(probability));
            });

            probabilityMatrix.push(probRow);
            countMatrix.push(countRow);
          });

          // Функция для обновления отображения матрицы
          function updateMatrixDisplay(showProbs) {
            var matrix = showProbs ? probabilityMatrix : countMatrix;
            var title = showProbs ? 'Вероятности переходов (%)' : 'Количество переходов';
            var colorscale = showProbs 
              ? [[0, '#ffffff'], [0.1, '#e3f2fd'], [0.3, '#90caf9'], [0.5, '#42a5f5'], [0.7, '#1e88e5'], [1, '#1565c0']]
              : [[0, '#ffffff'], [0.1, '#fff3e0'], [0.3, '#ffb74d'], [0.5, '#ff9800'], [0.7, '#f57c00'], [1, '#e65100']];

            var hoverTexts = [];
            for (var i = 0; i < categoriesExtended.length; i++) {
              var row = [];
              for (var j = 0; j < categoriesExtended.length; j++) {
                var fromCat = categoriesExtended[i];
                var toCat = categoriesExtended[j];
                var value = matrix[i][j];
                var details = transitionDetails[fromCat][toCat] || [];
                
                var hoverText = '<b>От:</b> ' + fromCat + '<br><b>К:</b> ' + toCat + '<br>';
                if (showProbs) {
                  hoverText += '<b>Вероятность:</b> ' + value.toFixed(1) + '%<br>';
                } else {
                  hoverText += '<b>Количество:</b> ' + value + '<br>';
                }
                
                if (details.length > 0) {
                  hoverText += '<b>Переходов:</b> ' + details.length + '<br>';
                }
                
                row.push(hoverText);
              }
              hoverTexts.push(row);
            }

            var heatmapTrace = {
              z: matrix,
              x: categoriesExtended,
              y: categoriesExtended,
              type: 'heatmap',
              colorscale: colorscale,
              showscale: true,
              colorbar: {
                title: showProbs ? 'Вероятность, %' : 'Количество',
                titleside: 'right',
                titlefont: { size: 12 }
              },
              text: matrix.map(function(row) {
                return row.map(function(val) {
                  return showProbs ? val.toFixed(1) + '%' : val.toString();
                });
              }),
              texttemplate: '%{text}',
              textfont: { size: 10, color: '#000' },
              customdata: hoverTexts,
              hoverinfo: 'text',
              hovertemplate: '%{customdata}<extra></extra>'
            };

            var layout = {
              title: {
                text: title + ' (' + startYear + '-' + endYear + ')',
                font: { size: 18, color: '#333' },
                x: 0.5,
                xanchor: 'center'
              },
              xaxis: {
                title: { text: 'Категория назначения', font: { size: 14 } },
                side: 'bottom',
                tickangle: -45
              },
              yaxis: {
                title: { text: 'Категория источника', font: { size: 14 } },
                autorange: 'reversed'
              },
              height: 700,
              margin: { l: 120, r: 50, t: 100, b: 150 },
              annotations: []
            };

            // Добавляем аннотации с числами
            for (var i = 0; i < categoriesExtended.length; i++) {
              for (var j = 0; j < categoriesExtended.length; j++) {
                var value = matrix[i][j];
                if (value > 0) {
                  var text = showProbs ? value.toFixed(1) + '%' : value.toString();
                  layout.annotations.push({
                    x: categoriesExtended[j],
                    y: categoriesExtended[i],
                    text: text,
                    showarrow: false,
                    font: { 
                      color: value > (showProbs ? 30 : 5) ? '#fff' : '#000',
                      size: 10
                    }
                  });
                }
              }
            }

            Plotly.react(container, [heatmapTrace], layout, { 
              displayModeBar: true,
              modeBarButtonsToRemove: ['pan2d', 'lasso2d', 'select2d'],
              responsive: true
            });
          }

          // Инициализация отображения
          var showProbsRadio = document.getElementById(showProbabilitiesId);
          var showCountsRadio = document.getElementById(showCountsId);
          var currentShowProbs = showProbsRadio && showProbsRadio.checked;

          if (showProbsRadio && showCountsRadio) {
            showProbsRadio.addEventListener('change', function() {
              if (this.checked) updateMatrixDisplay(true);
            });
            showCountsRadio.addEventListener('change', function() {
              if (this.checked) updateMatrixDisplay(false);
            });
          }

          updateMatrixDisplay(currentShowProbs !== false);
        }

        // Вкладка 1: Последние 5 лет
        var last5Container = document.getElementById('top50-top500-transition-matrix-last5');
        if (last5Container) {
          var last5EndYear = maxYear;
          var last5StartYear = Math.max(minYear, last5EndYear - 4); // Последние 5 лет включая текущий
          buildMatrixForPeriod(last5StartYear, last5EndYear, 'top50-top500-transition-matrix-last5', 'show-probabilities-last5', 'show-counts-last5');
        }

        // Вкладка 2: Интервалы по 2 года
        var intervalContainer = document.getElementById('top50-top500-transition-matrix-interval');
        var intervalSelector = document.getElementById('interval-selector');
        
        if (intervalSelector && intervalContainer) {
          // Генерируем опции для интервалов по 2 года
          var intervals = [];
          for (var year = minYear; year <= maxYear - 1; year += 2) {
            var endYear = Math.min(year + 1, maxYear);
            intervals.push({ start: year, end: endYear, label: year + '-' + endYear });
          }

          intervals.forEach(function(interval) {
            var option = document.createElement('option');
            option.value = interval.start + '-' + interval.end;
            option.textContent = interval.label;
            intervalSelector.appendChild(option);
          });

          // Обработчик изменения интервала
          intervalSelector.addEventListener('change', function() {
            if (this.value) {
              var parts = this.value.split('-');
              var startYear = parseInt(parts[0]);
              var endYear = parseInt(parts[1]);
              buildMatrixForPeriod(startYear, endYear, 'top50-top500-transition-matrix-interval', 'show-probabilities-interval', 'show-counts-interval');
            }
          });

          // Устанавливаем первый интервал по умолчанию
          if (intervals.length > 0) {
            intervalSelector.value = intervals[0].start + '-' + intervals[0].end;
            intervalSelector.dispatchEvent(new Event('change'));
          }
        }

        // Вкладка 3: Произвольный период
        var customContainer = document.getElementById('top50-top500-transition-matrix-custom');
        var customStartYear = document.getElementById('custom-start-year');
        var customEndYear = document.getElementById('custom-end-year');
        var applyCustomBtn = document.getElementById('apply-custom-period');

        if (applyCustomBtn && customStartYear && customEndYear && customContainer) {
          // Устанавливаем значения по умолчанию
          customStartYear.value = minYear;
          customEndYear.value = maxYear;

          applyCustomBtn.addEventListener('click', function() {
            var startYear = parseInt(customStartYear.value);
            var endYear = parseInt(customEndYear.value);

            if (isNaN(startYear) || isNaN(endYear)) {
              alert('Пожалуйста, введите корректные годы');
              return;
            }

            if (startYear > endYear) {
              alert('Год начала не может быть больше года конца');
              return;
            }

            if (startYear < minYear || endYear > maxYear) {
              alert('Период должен быть в диапазоне ' + minYear + '-' + maxYear);
              return;
            }

            buildMatrixForPeriod(startYear, endYear, 'top50-top500-transition-matrix-custom', 'show-probabilities-custom', 'show-counts-custom');
          });
        }
      }

      // --- 3D-куб переходов (год × от-класс × в-класс) ---
      if (transitionCubeContainer && years && years.length > 0 && categories && categories.length > 0) {
        var cubeX = []; // год
        var cubeY = []; // индекс категории FROM
        var cubeZ = []; // индекс категории TO
        var cubeValues = []; // вероятность
        var cubeText = [];

        years.forEach(function(year) {
          var yearKey = year; // ключ в yearlyCubes (Ruby-хэш сериализуется с такими же ключами)
          var matrix = yearlyCubes[yearKey] || [];
          for (var i = 0; i < matrix.length; i++) {
            for (var j = 0; j < matrix[i].length; j++) {
              var value = matrix[i][j];
              if (value && value > 0) {
                cubeX.push(year);
                cubeY.push(i);
                cubeZ.push(j);
                cubeValues.push(value);
                var fromCat = categories[i];
                var toCat = categories[j];
                cubeText.push(
                  '<b>Год:</b> ' + year +
                  '<br><b>От:</b> ' + fromCat +
                  '<br><b>К:</b> ' + toCat +
                  '<br><b>Вероятность:</b> ' + value.toFixed(1) + '%'
                );
              }
            }
          }
        });

        if (cubeValues.length > 0) {
          var maxValue = Math.max.apply(null, cubeValues);
          var minValue = Math.min.apply(null, cubeValues);

          var cubeTrace = {
            type: 'scatter3d',
            mode: 'markers',
            x: cubeX,
            y: cubeY,
            z: cubeZ,
            text: cubeText,
            hoverinfo: 'text',
            marker: {
              size: cubeValues.map(function(v) {
                // Масштабируем размер точки от 4 до 14
                return 4 + (v / (maxValue || 1)) * 10;
              }),
              color: cubeValues,
              colorscale: 'Viridis',
              cmin: minValue,
              cmax: maxValue,
              colorbar: {
                title: 'Вероятность, %',
                titleside: 'right'
              },
              opacity: 0.9,
              line: {
                width: 0.5,
                color: '#000'
              }
            }
          };

          var categoryIndices = categories.map(function(_, idx) { return idx; });

          var cubeLayout = {
            scene: {
              xaxis: {
                title: 'Год',
                type: 'linear',
                tickmode: 'array',
                tickvals: years,
                ticktext: years.map(String)
              },
              yaxis: {
                title: 'Категория ИЗ',
                tickmode: 'array',
                tickvals: categoryIndices,
                ticktext: categories
              },
              zaxis: {
                title: 'Категория В',
                tickmode: 'array',
                tickvals: categoryIndices,
                ticktext: categories
              }
            },
            margin: { l: 0, r: 0, t: 30, b: 0 },
            height: 700,
            hovermode: 'closest'
          };

          Plotly.newPlot(transitionCubeContainer, [cubeTrace], cubeLayout, { 
            displayModeBar: true,
            modeBarButtonsToRemove: ['lasso2d', 'select2d'],
            responsive: true
          });
        }
      }
    }
  });

