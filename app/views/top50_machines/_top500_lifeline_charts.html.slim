  document.addEventListener("DOMContentLoaded", function () {
    // Surface interpolation and smoothing functions (used in multiple charts)
    function interpolateSurface(z) {
      var interpolated = z.map(function(row) {
        return row.slice();
      });

      // First fill gaps with interpolation
      for (var pass = 0; pass < 3; pass++) {
        for (var i = 0; i < interpolated.length; i++) {
          for (var j = 0; j < interpolated[i].length; j++) {
            if (interpolated[i][j] === null || pass > 0) {
              // Find nearest known values for interpolation
              var neighbors = [];
              var searchRadius = pass === 0 ? 5 : 3;
              
              for (var di = -searchRadius; di <= searchRadius; di++) {
                for (var dj = -searchRadius; dj <= searchRadius; dj++) {
                  if (di === 0 && dj === 0) continue;
                  var ni = i + di;
                  var nj = j + dj;
                  if (ni >= 0 && ni < interpolated.length && nj >= 0 && nj < interpolated[i].length) {
                    if (interpolated[ni][nj] !== null) {
                      var dist = Math.sqrt(di * di + dj * dj);
                      // Gaussian kernel for smoother interpolation
                      var sigma = searchRadius / 2;
                      var weight = Math.exp(-(dist * dist) / (2 * sigma * sigma));
                      neighbors.push({ value: interpolated[ni][nj], weight: weight, dist: dist });
                    }
                  }
                }
              }

              if (neighbors.length > 0) {
                // Weighted interpolation with Gaussian kernel
                var totalWeight = 0;
                var weightedSum = 0;
                
                neighbors.forEach(function(n) {
                  weightedSum += n.value * n.weight;
                  totalWeight += n.weight;
                });
                
                var newValue = weightedSum / totalWeight;
                if (pass === 0 || Math.abs(newValue - interpolated[i][j]) < newValue * 0.1) {
                  interpolated[i][j] = newValue;
                }
              } else if (pass === 0) {
                // If no neighbors, use average across entire matrix
                var allValues = [];
                for (var ri = 0; ri < interpolated.length; ri++) {
                  for (var rj = 0; rj < interpolated[ri].length; rj++) {
                    if (interpolated[ri][rj] !== null) {
                      allValues.push(interpolated[ri][rj]);
                    }
                  }
                }
                interpolated[i][j] = allValues.length > 0 
                  ? allValues.reduce(function(a, b) { return a + b; }, 0) / allValues.length 
                  : 0;
              }
            }
          }
        }
      }

      return interpolated;
    }

    // Gaussian smoothing function to eliminate peaks
    function gaussianSmooth(z, iterations) {
      iterations = iterations || 2;
      var smoothed = z.map(function(row) {
        return row.slice();
      });

  
      var kernel = [
        [0.0625, 0.125, 0.0625],
        [0.125,  0.25,  0.125],
        [0.0625, 0.125, 0.0625]
      ];

      for (var iter = 0; iter < iterations; iter++) {
        var temp = smoothed.map(function(row) {
          return row.slice();
        });

        for (var i = 1; i < smoothed.length - 1; i++) {
          for (var j = 1; j < smoothed[i].length - 1; j++) {
            var sum = 0;
            var totalWeight = 0;

            for (var ki = -1; ki <= 1; ki++) {
              for (var kj = -1; kj <= 1; kj++) {
                var ni = i + ki;
                var nj = j + kj;
                if (ni >= 0 && ni < smoothed.length && nj >= 0 && nj < smoothed[i].length) {
                  var weight = kernel[ki + 1][kj + 1];
                  sum += smoothed[ni][nj] * weight;
                  totalWeight += weight;
                }
              }
            }

            temp[i][j] = sum / totalWeight;
          }
        }

        smoothed = temp;
      }

      return smoothed;
    }

    var top500_2d_data = #{raw @top500_2d_data.to_json};
    var top500_2d_container = document.getElementById('top500-2d-chart');

    if (top500_2d_container && top500_2d_data && top500_2d_data.length > 0) {
      var tickMap2d = {};
      top500_2d_data.forEach(function(system) {
        system.points.forEach(function(point) {
          tickMap2d[point.x_value] = point.x_label;
        });
      });
      var tickVals2d = Object.keys(tickMap2d).map(Number).sort(function(a, b) { return a - b; });
      var tickText2d = tickVals2d.map(function(val) { return tickMap2d[val]; });

      var traces_2d = top500_2d_data.map(function(system) {
        return {
          x: system.points.map(function(p) { return p.x_value; }),
          y: system.points.map(function(p) { return p.y; }),
          mode: 'lines+markers',
          name: system.name,
          text: system.points.map(function(p) { return p.label; }),
          hoverinfo: 'text+name',
          line: { width: 2, shape: 'spline', smoothing: 1.3 },
          marker: { size: 6 }
        };
      });

      var layout_2d = {
        xaxis: {
          title: 'Период публикации',
          tickmode: 'array',
          tickvals: tickVals2d,
          ticktext: tickText2d,
          nticks: tickVals2d.length,
          showgrid: true,
          zeroline: false
        },
        yaxis: {
          title: 'Позиция в рейтинге',
          autorange: 'reversed',
          dtick: 50
        },
        hovermode: 'closest',
        height: 600,
        showlegend: true,
        legend: {
          orientation: 'h',
          yanchor: 'top',
          y: -0.2,
          xanchor: 'center',
          x: 0.5
        },
        margin: { l: 80, r: 20, t: 20, b: 120 }
      };

      Plotly.newPlot(top500_2d_container, traces_2d, layout_2d, { displayModeBar: false });
    }

    var top500_3d_data = #{raw @top500_3d_data.to_json};
    var top500_3d_container = document.getElementById('top500-3d-chart');

    if (top500_3d_container && top500_3d_data && top500_3d_data.length > 0) {
      var traces_3d = top500_3d_data.map(function(system) {
        return {
          x: system.points.map(function(p) { return p.x; }),
          y: system.points.map(function(p) { return p.y; }),
          z: system.points.map(function(p) { return p.z; }),
          mode: 'lines+markers',
          type: 'scatter3d',
          name: system.name,
          text: system.points.map(function(p) { return p.tooltip; }),
          hoverinfo: 'text',
          line: { width: 4 },
          marker: { size: 4 }
        };
      });

      var tickMap3d = {};
      top500_3d_data.forEach(function(system) {
        system.points.forEach(function(point) {
          if (tickMap3d[point.x] === undefined) {
            tickMap3d[point.x] = point.x_label;
          }
        });
      });

      var tickVals3d = Object.keys(tickMap3d).map(Number).sort(function(a, b) { return a - b; });
      var tickText3d = tickVals3d.map(function(value) { return tickMap3d[value]; });

      var layout_3d = {
        scene: {
          xaxis: {
            title: 'Период публикации',
            tickvals: tickVals3d,
            ticktext: tickText3d,
            tickmode: 'array'
          },
          yaxis: {
            title: 'Позиция в рейтинге',
            autorange: 'reversed',
            dtick: 50
          },
          zaxis: { title: 'Производительность (значение)' }
        },
        height: 700,
        showlegend: true,
        legend: {
          orientation: 'h',
          yanchor: 'top',
          y: -0.2,
          xanchor: 'center',
          x: 0.5
        },
        margin: { l: 0, r: 0, t: 0, b: 80 }
      };

      Plotly.newPlot(top500_3d_container, traces_3d, layout_3d, { displayModeBar: false });
    }

    var histogramData = #{raw @top50_top500_histogram.to_json};
    var histogramContainer = document.getElementById('top50-top500-hist');

    if (histogramContainer && histogramData && histogramData.labels && histogramData.labels.length > 0) {
      var updatedTrace = {
        x: histogramData.labels,
        y: histogramData.updated_percentages,
        name: '% обновлённых систем Top50',
        type: 'bar',
        marker: { color: '#007bff' }
      };

      var top500Trace = {
        x: histogramData.labels,
        y: histogramData.top500_percentages,
        name: '% систем Top50 в Top500',
        type: 'bar',
        marker: { color: '#28a745' }
      };

      var histogramLayout = {
        barmode: 'group',
        xaxis: { title: 'Выпуск' },
        yaxis: {
          title: 'Доля систем, %',
          range: [0, 100]
        },
        margin: { l: 70, r: 20, t: 40, b: 80 },
        legend: {
          orientation: 'h',
          yanchor: 'top',
          y: -0.2,
          xanchor: 'center',
          x: 0.5
        }
      };

      Plotly.newPlot(histogramContainer, [updatedTrace, top500Trace], histogramLayout, { displayModeBar: false });
    }

    var dropData = #{raw @top50_top500_drop_chart.to_json};
    var dropAxis = #{raw @top50_top500_drop_axis.to_json};
    var dropContainer = document.getElementById('top50-top500-drop');

    if (dropContainer && dropData && dropData.length > 0) {
      var dropTraces = [];

      dropData.forEach(function(series) {
        dropTraces.push({
          x: series.x,
          y: series.y,
          mode: 'lines+markers',
          name: series.name,
          text: series.hover,
          hoverinfo: 'text',
          line: { width: 2 },
          marker: { size: 4 }
        });

        if (series.top50_y && series.top50_y.some(function(val) { return val !== null; })) {
          dropTraces.push({
            x: series.x,
            y: series.top50_y,
            mode: 'lines+markers',
            name: series.name + ' (Top50)',
            text: series.top50_hover,
            hoverinfo: 'text',
            line: { width: 2, dash: 'dash', color: '#ff7f0e' },
            marker: { size: 4, symbol: 'diamond', color: '#ff7f0e' },
            yaxis: 'y2'
          });
        }
      });

      var dropLayout = {
        xaxis: {
          title: 'Период публикации',
          tickvals: dropAxis && dropAxis.tickvals ? dropAxis.tickvals : undefined,
          ticktext: dropAxis && dropAxis.ticktext ? dropAxis.ticktext : undefined
        },
        yaxis: {
          title: 'Позиция в Top500',
          autorange: 'reversed'
        },
        yaxis2: {
          title: 'Позиция в Top50',
          autorange: 'reversed',
          overlaying: 'y',
          side: 'right',
          range: [50, 1]
        },
        hovermode: 'closest',
        height: 600,
        showlegend: true,
        legend: {
          orientation: 'h',
          yanchor: 'top',
          y: -0.2,
          xanchor: 'center',
          x: 0.5
        },
        margin: { l: 80, r: 20, t: 40, b: 80 }
      };

      Plotly.newPlot(dropContainer, dropTraces, dropLayout, { displayModeBar: false });
    }


    var candlestickHalfYearRuData = #{raw @top50_top500_candlestick.to_json};
    var candlestickHalfYearRuContainer = document.getElementById('top50-top500-candlestick-halfyear-ru');

    if (candlestickHalfYearRuContainer && candlestickHalfYearRuData && candlestickHalfYearRuData.length > 0) {
      candlestickHalfYearRuData.sort(function(a, b) {
        return (a.period_numeric || 0) - (b.period_numeric || 0);
      });

      var halfYearRuData = candlestickHalfYearRuData.filter(function(c) { return c.period_type === 'quarter'; });
      var halfYearRuYearData = candlestickHalfYearRuData.filter(function(c) { return c.period_type === 'year'; });
      var halfYearRuTraces = [];

      if (halfYearRuData.length > 0) {
        var halfYearRuPeriods = halfYearRuData.map(function(c) { return c.x; });
        var halfYearRuOpen = halfYearRuData.map(function(c) { return c.open; });
        var halfYearRuHigh = halfYearRuData.map(function(c) { return c.high; });
        var halfYearRuLow = halfYearRuData.map(function(c) { return c.low; });
        var halfYearRuClose = halfYearRuData.map(function(c) { return c.close; });

        var halfYearRuHoverTexts = halfYearRuData.map(function(c) {
          var systemsList = c.systems && c.systems.length > 0
            ? '<br>Системы: ' + c.systems.slice(0, 3).join(', ') + (c.systems.length > 3 ? '...' : '')
            : '';
          return '<b>' + c.x + '</b> (полугодие)' +
                 '<br>Открытие: позиция ' + c.open +
                 '<br>Закрытие: позиция ' + c.close +
                 '<br>Лучшая позиция: ' + c.high +
                 '<br>Худшая позиция: ' + c.low +
                 '<br>Количество систем: ' + c.systems_count +
                 systemsList;
        });

        halfYearRuTraces.push({
          type: 'candlestick',
          x: halfYearRuPeriods,
          open: halfYearRuOpen,
          high: halfYearRuHigh,
          low: halfYearRuLow,
          close: halfYearRuClose,
          increasing: { line: { color: '#26a69a', width: 2 }, fillcolor: '#26a69a' },
          decreasing: { line: { color: '#ef5350', width: 2 }, fillcolor: '#ef5350' },
          text: halfYearRuHoverTexts,
          hoverinfo: 'text',
          name: 'Полугодовые позиции в Top500',
          xaxis: 'x',
          yaxis: 'y'
        });
      }

      if (halfYearRuYearData.length > 0) {
        var halfYearRuYearPeriods = halfYearRuYearData.map(function(c) { return c.x; });
        var halfYearRuYearOpen = halfYearRuYearData.map(function(c) { return c.open; });
        var halfYearRuYearHigh = halfYearRuYearData.map(function(c) { return c.high; });
        var halfYearRuYearLow = halfYearRuYearData.map(function(c) { return c.low; });
        var halfYearRuYearClose = halfYearRuYearData.map(function(c) { return c.close; });

        var halfYearRuYearHoverTexts = halfYearRuYearData.map(function(c) {
          var systemsList = c.systems && c.systems.length > 0
            ? '<br>Системы: ' + c.systems.slice(0, 5).join(', ') + (c.systems.length > 5 ? '...' : '')
            : '';
          return '<b>' + c.x + '</b> (год)' +
                 '<br>Открытие (первое полугодие): позиция ' + c.open +
                 '<br>Закрытие (второе полугодие): позиция ' + c.close +
                 '<br>Лучшая позиция за год: ' + c.high +
                 '<br>Худшая позиция за год: ' + c.low +
                 '<br>Количество систем: ' + c.systems_count +
                 systemsList;
        });

        halfYearRuTraces.push({
          type: 'candlestick',
          x: halfYearRuYearPeriods,
          open: halfYearRuYearOpen,
          high: halfYearRuYearHigh,
          low: halfYearRuYearLow,
          close: halfYearRuYearClose,
          increasing: { line: { color: '#1976d2', width: 3 }, fillcolor: '#1976d2' },
          decreasing: { line: { color: '#d32f2f', width: 3 }, fillcolor: '#d32f2f' },
          text: halfYearRuYearHoverTexts,
          hoverinfo: 'text',
          name: 'Годовые позиции в Top500',
          xaxis: 'x',
          yaxis: 'y'
        });
      }

      var halfYearRuCandlestickLayout = {
        title: {
          text: 'Волатильность позиций систем Top50 в рейтинге Top500 по полугодиям',
          font: { size: 18, color: '#333' },
          x: 0.5,
          xanchor: 'center'
        },
        xaxis: {
          title: {
            text: 'Период',
            font: { size: 14 }
          },
          type: 'category',
          tickangle: -45,
          showgrid: true,
          gridcolor: 'rgba(128, 128, 128, 0.2)'
