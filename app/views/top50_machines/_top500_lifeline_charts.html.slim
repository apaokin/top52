javascript:
  document.addEventListener("DOMContentLoaded", function () {
    // Функции интерполяции и сглаживания поверхности (используются в нескольких графиках)
    function interpolateSurface(z) {
      var interpolated = z.map(function(row) {
        return row.slice();
      });

      // Сначала заполняем пропуски интерполяцией
      for (var pass = 0; pass < 3; pass++) {
        for (var i = 0; i < interpolated.length; i++) {
          for (var j = 0; j < interpolated[i].length; j++) {
            if (interpolated[i][j] === null || pass > 0) {
              // Находим ближайшие известные значения для интерполяции
              var neighbors = [];
              var searchRadius = pass === 0 ? 5 : 3;
              
              for (var di = -searchRadius; di <= searchRadius; di++) {
                for (var dj = -searchRadius; dj <= searchRadius; dj++) {
                  if (di === 0 && dj === 0) continue;
                  var ni = i + di;
                  var nj = j + dj;
                  if (ni >= 0 && ni < interpolated.length && nj >= 0 && nj < interpolated[i].length) {
                    if (interpolated[ni][nj] !== null) {
                      var dist = Math.sqrt(di * di + dj * dj);
                      // Гауссово ядро для более плавной интерполяции
                      var sigma = searchRadius / 2;
                      var weight = Math.exp(-(dist * dist) / (2 * sigma * sigma));
                      neighbors.push({ value: interpolated[ni][nj], weight: weight, dist: dist });
                    }
                  }
                }
              }

              if (neighbors.length > 0) {
                // Взвешенная интерполяция с гауссовым ядром
                var totalWeight = 0;
                var weightedSum = 0;
                
                neighbors.forEach(function(n) {
                  weightedSum += n.value * n.weight;
                  totalWeight += n.weight;
                });
                
                var newValue = weightedSum / totalWeight;
                if (pass === 0 || Math.abs(newValue - interpolated[i][j]) < newValue * 0.1) {
                  interpolated[i][j] = newValue;
                }
              } else if (pass === 0) {
                // Если нет соседей, используем среднее по всей матрице
                var allValues = [];
                for (var ri = 0; ri < interpolated.length; ri++) {
                  for (var rj = 0; rj < interpolated[ri].length; rj++) {
                    if (interpolated[ri][rj] !== null) {
                      allValues.push(interpolated[ri][rj]);
                    }
                  }
                }
                interpolated[i][j] = allValues.length > 0 
                  ? allValues.reduce(function(a, b) { return a + b; }, 0) / allValues.length 
                  : 0;
              }
            }
          }
        }
      }

      return interpolated;
    }

    // Функция гауссова сглаживания для устранения пиков
    function gaussianSmooth(z, iterations) {
      iterations = iterations || 2;
      var smoothed = z.map(function(row) {
        return row.slice();
      });

      // Гауссово ядро 3x3
      var kernel = [
        [0.0625, 0.125, 0.0625],
        [0.125,  0.25,  0.125],
        [0.0625, 0.125, 0.0625]
      ];

      for (var iter = 0; iter < iterations; iter++) {
        var temp = smoothed.map(function(row) {
          return row.slice();
        });

        for (var i = 1; i < smoothed.length - 1; i++) {
          for (var j = 1; j < smoothed[i].length - 1; j++) {
            var sum = 0;
            var totalWeight = 0;

            for (var ki = -1; ki <= 1; ki++) {
              for (var kj = -1; kj <= 1; kj++) {
                var ni = i + ki;
                var nj = j + kj;
                if (ni >= 0 && ni < smoothed.length && nj >= 0 && nj < smoothed[i].length) {
                  var weight = kernel[ki + 1][kj + 1];
                  sum += smoothed[ni][nj] * weight;
                  totalWeight += weight;
                }
              }
            }

            temp[i][j] = sum / totalWeight;
          }
        }

        smoothed = temp;
      }

      return smoothed;
    }

    var top500_2d_data = #{raw @top500_2d_data.to_json};
    var top500_2d_container = document.getElementById('top500-2d-chart');

    if (top500_2d_container && top500_2d_data && top500_2d_data.length > 0) {
      var tickMap2d = {};
      top500_2d_data.forEach(function(system) {
        system.points.forEach(function(point) {
          tickMap2d[point.x_value] = point.x_label;
        });
      });
      var tickVals2d = Object.keys(tickMap2d).map(Number).sort(function(a, b) { return a - b; });
      var tickText2d = tickVals2d.map(function(val) { return tickMap2d[val]; });

      var traces_2d = top500_2d_data.map(function(system) {
        return {
          x: system.points.map(function(p) { return p.x_value; }),
          y: system.points.map(function(p) { return p.y; }),
          mode: 'lines+markers',
          name: system.name,
          text: system.points.map(function(p) { return p.label; }),
          hoverinfo: 'text+name',
          line: { width: 2, shape: 'spline', smoothing: 1.3 },
          marker: { size: 6 }
        };
      });

      var layout_2d = {
        xaxis: {
          title: 'Период публикации',
          tickmode: 'array',
          tickvals: tickVals2d,
          ticktext: tickText2d,
          nticks: tickVals2d.length,
          showgrid: true,
          zeroline: false
        },
        yaxis: {
          title: 'Позиция в рейтинге',
          autorange: 'reversed',
          dtick: 50
        },
        hovermode: 'closest',
        height: 600,
        showlegend: true,
        legend: {
          orientation: 'h',
          yanchor: 'top',
          y: -0.2,
          xanchor: 'center',
          x: 0.5
        },
        margin: { l: 80, r: 20, t: 20, b: 120 }
      };

      Plotly.newPlot(top500_2d_container, traces_2d, layout_2d, { displayModeBar: false });
    }

    var top500_2d_plane_data = #{raw @top500_3d_data.to_json};
    var top500_surface_actual_data = #{raw @top500_surface_actual.to_json};
    var top500_2d_plane_container = document.getElementById('top500-2d-plane-chart');

    if (top500_2d_plane_container && top500_2d_plane_data && top500_2d_plane_data.length > 0 && top500_surface_actual_data) {
      // Создаем поверхность, которая проходит через все точки
      // Используем интерполяцию для создания плавной поверхности, объединяющей все точки
      var surfaceZ = top500_surface_actual_data.z.map(function(row) {
        return row.map(function(value) {
          return value === null ? null : value;
        });
      });

      var interpolatedZ = interpolateSurface(surfaceZ);
      // Применяем гауссово сглаживание для устранения пиков
      interpolatedZ = gaussianSmooth(interpolatedZ, 3);

      var surfaceTrace = {
        type: 'surface',
        x: top500_surface_actual_data.x,
        y: top500_surface_actual_data.y,
        z: interpolatedZ,
        opacity: 0.75,
        colorscale: 'Viridis',
        showscale: true,
        colorbar: {
          title: 'Производительность (score)',
          titleside: 'right'
        },
        lighting: {
          ambient: 0.8,
          diffuse: 0.9,
          specular: 0.05,
          roughness: 0.9,
          fresnel: 0.1
        },
        lightposition: {
          x: 100,
          y: 100,
          z: 1000
        },
        // Дополнительные параметры для сглаживания
        contours: {
          z: {
            show: false
          }
        },
        // Используем более плавное отображение
        hoverinfo: 'skip'
      };

      // Создаем точки (только маркеры, без линий)
      var pointTraces = top500_2d_plane_data.map(function(system) {
        return {
          x: system.points.map(function(p) { return p.x; }),
          y: system.points.map(function(p) { return p.y; }),
          z: system.points.map(function(p) { return p.z; }),
          mode: 'markers',
          type: 'scatter3d',
          name: system.name,
          text: system.points.map(function(p) { return p.tooltip; }),
          hoverinfo: 'text',
          marker: { 
            size: 5,
            color: '#ff0000',
            line: { width: 1, color: '#000000' },
            opacity: 0.9
          },
          showlegend: false
        };
      });

      var tickMapPlane = {};
      top500_2d_plane_data.forEach(function(system) {
        system.points.forEach(function(point) {
          if (tickMapPlane[point.x] === undefined) {
            tickMapPlane[point.x] = point.x_label;
          }
        });
      });

      var tickValsPlane = Object.keys(tickMapPlane).map(Number).sort(function(a, b) { return a - b; });
      var tickTextPlane = tickValsPlane.map(function(value) { return tickMapPlane[value]; });

      var layout_plane = {
        scene: {
          xaxis: {
            title: 'Период публикации',
            tickvals: tickValsPlane,
            ticktext: tickTextPlane,
            tickmode: 'array'
          },
          yaxis: {
            title: 'Позиция в рейтинге',
            autorange: 'reversed',
            dtick: 50
          },
          zaxis: { title: 'Производительность (score)' }
        },
        height: 700,
        showlegend: false,
        margin: { l: 0, r: 0, t: 0, b: 0 }
      };

      Plotly.newPlot(top500_2d_plane_container, [surfaceTrace].concat(pointTraces), layout_plane, { displayModeBar: false });
    }

    var top50_top500_combined_data = #{raw @top50_top500_combined_surface.to_json};
    var top50_top500_combined_container = document.getElementById('top50-top500-combined-surface');

    if (top50_top500_combined_container && top50_top500_combined_data && top50_top500_combined_data.systems) {
      var combinedSystems = top50_top500_combined_data.systems || [];
      var surfaceData = top50_top500_combined_data.surface || {};
      var allPoints = top50_top500_combined_data.points || [];

      // Создаем точки для всех систем
      var pointTraces = combinedSystems.map(function(system) {
        var x = [], y = [], z = [], texts = [];
        
        system.points.forEach(function(point) {
          if (point.y !== null && point.y !== undefined) {
            x.push(point.x);
            y.push(point.y);
            z.push(point.z);
            texts.push(point.tooltip || (system.name + '<br>Период: ' + point.x_label + '<br>Top50: ' + point.y + '<br>Top500: ' + point.z));
          }
        });

        return {
          x: x,
          y: y,
          z: z,
          mode: 'markers',
          type: 'scatter3d',
          name: system.name,
          text: texts,
          hoverinfo: 'text',
          marker: {
            size: 4,
            color: '#ff0000',
            line: { width: 0.5, color: '#000000' },
            opacity: 0.8
          },
          showlegend: false
        };
      });

      // Создаем поверхность через точки
      if (surfaceData.x && surfaceData.y && surfaceData.z) {
        var surfaceZ = surfaceData.z.map(function(row) {
          return row.map(function(value) {
            return value === null ? null : value;
          });
        });

        // Сначала сохраняем точные значения из реальных точек
        // Используем точное сравнение координат, а не индексы
        var exactPoints = {};
        var tolerance = 0.001; // Допустимая погрешность для сравнения координат
        
        allPoints.forEach(function(point) {
          if (point.y !== null && point.y !== undefined) {
            // Находим ближайшие индексы в сетке
            var xIdx = -1;
            var minXDist = Infinity;
            for (var i = 0; i < surfaceData.x.length; i++) {
              var dist = Math.abs(surfaceData.x[i] - point.x);
              if (dist < minXDist && dist < tolerance) {
                minXDist = dist;
                xIdx = i;
              }
            }
            
            var yIdx = -1;
            var minYDist = Infinity;
            for (var i = 0; i < surfaceData.y.length; i++) {
              var dist = Math.abs(surfaceData.y[i] - point.y);
              if (dist < minYDist && dist < tolerance) {
                minYDist = dist;
                yIdx = i;
              }
            }
            
            if (xIdx >= 0 && yIdx >= 0) {
              var key = yIdx + '_' + xIdx;
              exactPoints[key] = point.z;
              // Также устанавливаем значение напрямую в исходной матрице
              if (surfaceZ[yIdx] && surfaceZ[yIdx][xIdx] === null) {
                surfaceZ[yIdx][xIdx] = point.z;
              }
            }
          }
        });

        // Используем интерполяцию для заполнения пропусков
        var interpolatedZ = interpolateSurface(surfaceZ);
        
        // Восстанавливаем точные значения в местах реальных точек
        for (var key in exactPoints) {
          var parts = key.split('_');
          var yIdx = parseInt(parts[0]);
          var xIdx = parseInt(parts[1]);
          if (yIdx >= 0 && yIdx < interpolatedZ.length && xIdx >= 0 && xIdx < interpolatedZ[yIdx].length) {
            interpolatedZ[yIdx][xIdx] = exactPoints[key];
          }
        }

        // Применяем легкое сглаживание, но сохраняем точные значения
        var smoothedZ = gaussianSmooth(interpolatedZ, 1);
        
        // Снова восстанавливаем точные значения после сглаживания
        for (var key in exactPoints) {
          var parts = key.split('_');
          var yIdx = parseInt(parts[0]);
          var xIdx = parseInt(parts[1]);
          if (yIdx >= 0 && yIdx < smoothedZ.length && xIdx >= 0 && xIdx < smoothedZ[yIdx].length) {
            smoothedZ[yIdx][xIdx] = exactPoints[key];
          }
        }
        
        interpolatedZ = smoothedZ;

        var combinedSurfaceTrace = {
          type: 'surface',
          x: surfaceData.x,
          y: surfaceData.y,
          z: interpolatedZ,
          opacity: 0.6,
