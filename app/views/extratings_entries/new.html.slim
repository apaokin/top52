.container.mt-4
  .card
    .card-header.bg-primary.text-white
      h5.mb-0 Добавление вхождения системы в рейтинг

    .card-body
      = form_for @extratings_entry, html: { class: 'needs-validation g-3', novalidate: true }, remote: true do |f|
        .row.mb-4
          .col-md-6.mb-3.mb-md-0
            = f.label :system_id, "Система", class: 'form-label fw-bold'
            = f.select :system_id,
                      options_for_select(@systems.map { |s| ["#{s.display_name} (#{s.machine_id})", s.relation_id] }),
                      { prompt: "Выберите систему..." },
                      class: 'form-select', required: true
            .invalid-feedback Пожалуйста, выберите систему

          .col-md-6.mb-3.mb-md-0
            = label_tag :extratings_list_id, "Лист рейтинга", class: 'form-label fw-bold'
            = select_tag :extratings_list_id,
                        options_from_collection_for_select(@extratings_lists, :id, :name_eng),
                        { prompt: "Выберите лист...", class: 'form-select', required: true }
            .invalid-feedback Пожалуйста, выберите лист рейтинга

            = link_to "Добавить новый рейтинг", new_extratings_list_path, class: 'btn btn-outline-primary mt-2'

        .row.mb-4
          .col-md-4.mb-3.mb-md-0
            = label_tag :edition_number, "Номер редакции", class: 'form-label fw-bold'
            = number_field_tag :edition_number, nil, class: 'form-control', required: true
            .invalid-feedback Пожалуйста, укажите номер

          .col-md-4.mb-3.mb-md-0
            = label_tag :publication_date, "Дата публикации", class: 'form-label fw-bold'
            = date_field_tag :publication_date, Date.today, class: 'form-control', required: true
            .invalid-feedback Пожалуйста, укажите дату

          .col-md-4
            = f.label :position, "Позиция", class: 'form-label fw-bold'
            = f.number_field :position, class: 'form-control', required: true
            .invalid-feedback Пожалуйста, укажите позицию

        #units-list.mb-4
          / Поля для оценок будут подгружаться здесь

        .d-flex.justify-content-end
          = link_to "Отмена", extratings_entries_path, class: 'btn btn-outline-secondary me-2'
          = f.submit "Сохранить", class: 'btn btn-primary'

javascript:
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector('.needs-validation');
    form.addEventListener('submit', function(event) {
      if (!form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();
      }
      form.classList.add('was-validated');
    }, false);

    const listSelect = document.querySelector('select[name="extratings_list_id"]');
    const unitsDiv = document.getElementById("units-list");

    listSelect.addEventListener("change", () => {
      const listId = listSelect.value;
      unitsDiv.innerHTML = `
        <div class="text-center py-4">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
          </div>
          <p class="mt-2">Загрузка параметров рейтинга...</p>
        </div>
      `;

      if (!listId) {
        unitsDiv.innerHTML = '';
        return;
      }

      fetch(`/extratings_entries/list_units?list_id=${listId}`, {
        headers: { "Accept": "application/json" }
      })
      .then(response => response.json())
      .then(data => {
        if (data.length === 0) {
          unitsDiv.innerHTML = '<div class="alert alert-info">Для выбранного рейтинга нет параметров оценки</div>';
          return;
        }

        const unitGroups = {};
        data.forEach(unit => {
          if (!unitGroups[unit.unit_name]) unitGroups[unit.unit_name] = [];
          unitGroups[unit.unit_name].push(unit);
        });

        let html = `
          <div class="card mb-4">
            <div class="card-header bg-light">
              <h6 class="mb-0">Параметры оценки</h6>
            </div>
            <div class="card-body">
              <div class="row g-4">
        `;

        Object.entries(unitGroups).forEach(([name, units]) => {
          html += `
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">${name}</label>
                <div class="input-group">
                  <select class="form-select" name="selected_units[${name}]" required>
                    <option value="">Выберите единицу...</option>
                    ${units.map(u => `<option value="${u.id}">${u.measure_unit}</option>`).join('')}
                  </select>
                  <input type="number"
                         name="scores[${name}]"
                         class="form-control"
                         placeholder="Введите значение"
                         required>
                </div>
              </div>
            </div>
          `;
        });

        html += `</div></div></div>`;
        unitsDiv.innerHTML = html;
      })
      .catch(() => {
        unitsDiv.innerHTML = '<div class="alert alert-danger">Ошибка загрузки параметров</div>';
      });
    });
  });