.container.mt-4
  .card
    .card-header.bg-secondary.text-white
      h5.mb-0 Новая единица измерения

    .card-body
      = form_for @extratings_unit do |f|
        .mb-3
          = f.label :name_ru, "Название (RU)", class: 'form-label'
          = f.text_field :name_ru, class: 'form-control', required: true

        .mb-3
          = f.label :name_eng, "Название (EN)", class: 'form-label'
          = f.text_field :name_eng, class: 'form-control'

        .mb-3
          = f.label :measure_unit, "Единица измерения", class: 'form-label'
          = f.text_field :measure_unit, class: 'form-control'

        .mb-3
          = f.label :base_multiplier, "Множитель", class: 'form-label'
          = f.number_field :base_multiplier, class: 'form-control', step: 0.0001

        .mt-4
          = f.submit "Создать", class: 'btn btn-primary'
          = link_to "Отмена", new_extratings_list_path, class: "btn btn-outline-secondary ms-2"
